# =============================================================================
# Instagrowth — environment template.
# Copy to `.env` and fill in. NEVER commit the real `.env`.
#   cp .env.example .env
# Secrets are read via pydantic-settings (app/config.py). Store them via Docker
# secrets or Supabase Vault in production.
# =============================================================================

# --- Supabase / Postgres 17 --------------------------------------------------
# Full connection string (psycopg). e.g. postgresql://postgres:[PW]@db.X.supabase.co:5432/postgres
SUPABASE_DB_URL=
# Project ref (for supabase-py + Vault). e.g. abcdefghijklmnop
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# --- Meta / Instagram Graph API (v25.0) --------------------------------------
# IG Business account id (graph.facebook.com/v25.0/{IG_USER_ID})
IG_USER_ID=
# Two paths:
#   • Instagram Login  → 60-day token (instagram_business_* scopes). token_health refreshes it.
#   • Facebook Login   → non-expiring System User token (Business Manager).
META_TOKEN=
# Set META_TOKEN_KIND=system_user ONLY for a Facebook-Login System User token; leave blank otherwise.
META_TOKEN_KIND=
# Instagram Login path → graph.instagram.com (default); Facebook Login → graph.facebook.com
IG_API_HOST=graph.instagram.com
IG_API_VERSION=v25.0

# --- Google Gemini (fallback + Grounding) -----------------------------------
GEMINI_API_KEY=
GEMINI_MODEL_PRIMARY=gemini-3.5-flash
GEMINI_MODEL_FALLBACK=gemini-3.1-flash-lite

# --- Z.ai / ZhipuAI GLM (PRIMARY LLM) ---------------------------------------
GLM_API_KEY=
GLM_BASE_URL=https://api.z.ai/api/paas/v4
GLM_MODEL=glm-5.2
# Per-1M-token pricing (0 = flat plan like Z.ai Coding; set for pay-as-you-go)
GLM_PRICE_INPUT_PER_1M=0
GLM_PRICE_OUTPUT_PER_1M=0

# --- Provider routing (Gemini primary: #1 Arabic/Masri + Grounding; GLM fallback) ---
AI_PROVIDER_PRIMARY=gemini
AI_PROVIDER_FALLBACK=glm

# --- Telegram (delivery + HITL bot) ------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Email / SMTP (delivery) -------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- Runtime -----------------------------------------------------------------
# Account timezone (used for best-time + cron local time). Default Africa/Cairo.
ACCOUNT_TIMEZONE=Africa/Cairo
# Meta Graph API version
IG_API_VERSION=v25.0
# Trend scan: max items per source
TREND_MAX_PER_SOURCE=30
# Log level
LOG_LEVEL=INFO
